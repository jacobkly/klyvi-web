# Klyvi web — local dev env. Copy to `.env.local` and fill in.
# `.env.local` is gitignored.

# Klyvi Go API base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase project URL and anon key.
# Anon key is safe to expose client-side — it's the public publishable key,
# NOT the service_role secret. Get both from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY
